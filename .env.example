# Copy to .env and fill in. Generate a key with: openssl rand -hex 32
SECRET_KEY=change-me
# Plain HTTP on the LAN: keep 0. Set 1 only if you later serve the site over HTTPS.
COOKIE_SECURE=0
MAX_CONTENT_LENGTH=2147483648
WORKERS=4
# Interface language when the browser has not chosen one: fa or en
DEFAULT_LANG=fa
